From bef3ab3a7c3e945963178b39dddb2ac3a51a3919 Mon Sep 17 00:00:00 2001
From: Wayne Ren <renwei@kylinos.cn>
Date: Thu, 5 Nov 2026 19:41:34 +0800
Subject: [PATCH] arm64: dts: stm32: hand the M33 over to the MICA framework

mcs_km resets the M33 through the SCMI resets, passes the non-secure
vector through a35ss_syscfg and rings the vq0/vq1 IPCC mailboxes, so
the in-kernel stm32_rproc driver must not claim the same resources.
Disable m33_rproc and describe the oe,mcs_stm32mp2_remoteproc node
with the memory regions in the order expected by mcs_km.

Co-Authored-By: DeepSeek-Flash
Signed-off-by: Wayne Ren <renwei@kylinos.cn>
---
 .../boot/dts/myir/myb-stm32mp257x-base.dtsi   | 38 +++++++++++++++----
 1 file changed, 30 insertions(+), 8 deletions(-)

diff --git a/arch/arm64/boot/dts/myir/myb-stm32mp257x-base.dtsi b/arch/arm64/boot/dts/myir/myb-stm32mp257x-base.dtsi
index 8cf57172a..49feb48c1 100644
--- a/arch/arm64/boot/dts/myir/myb-stm32mp257x-base.dtsi
+++ b/arch/arm64/boot/dts/myir/myb-stm32mp257x-base.dtsi
@@ -1112,15 +1112,37 @@ &m0_rproc {
 	status = "okay";
 };
 
+/*
+ * The M33 is owned by the MICA heterogeneous OS framework: mcs_km boots
+ * and stops it through the SCMI resets and exchanges the vring
+ * notifications over the vq0/vq1 IPCC channels. Disable the in-kernel
+ * stm32_rproc driver so that those resources are managed by the
+ * mcs-stm32mp2-remoteproc node below instead.
+ */
 &m33_rproc {
-	mboxes = <&ipcc1 0x100>, <&ipcc1 0x101>, <&ipcc1 2>;
-	mbox-names = "vq0", "vq1", "shutdown";
-	memory-region = <&cm33_cube_fw>, <&cm33_cube_data>,
-			<&ipc_shmem_1>, <&vdev0vring0>,
-			<&vdev0vring1>, <&vdev0buffer>,
-			<&cm33_sram2>;
-	st,syscfg-nsvtor = <&a35ss_syscfg 0xa8 0xffffff80>;
-	status = "okay";
+	status = "disabled";
+};
+
+/*
+ * MICA resources used by the mcs_km module:
+ * - the same reset controls and boot vector register as the in-kernel
+ *   stm32_rproc driver,
+ * - the vq0/vq1 IPCC mailbox channels for the vring notifications,
+ * - the memory regions in the order expected by mcs_km: the IPC shared
+ *   memory first, then the Zephyr firmware and data areas.
+ */
+/ {
+	mcs-stm32mp2-remoteproc {
+		compatible = "oe,mcs_stm32mp2_remoteproc";
+		resets = <&scmi_reset RST_SCMI_C2_R>,
+			 <&scmi_reset RST_SCMI_C2_HOLDBOOT_R>;
+		reset-names = "mcu_rst", "hold_boot";
+		st,syscfg-nsvtor = <&a35ss_syscfg 0xa8 0xffffff80>;
+		mboxes = <&ipcc1 0x100>, <&ipcc1 0x101>;
+		mbox-names = "vq0", "vq1";
+		memory-region = <&ipc_shmem_1>, <&cm33_cube_fw>,
+				<&cm33_cube_data>;
+	};
 };
 
 &m_can1 {
